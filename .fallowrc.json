{
  "$schema": "https://fallow.tools/schema.json",
  "entry": [
    "demos/*/src/live.config.ts",
    "scripts/seed-probe.ts",
    "scripts/daisy-live-check.ts",
    "packages/emvb-daisyui/scripts/render-sections-preview.ts",
    "demos/cloudflare/daisy-conformance.vite.config.ts",
    "demos/cloudflare/conformance/**",
    "playwright.live.config.ts",
    "e2e/live/**"
  ],
  "ignorePatterns": [
    "spikes/**",
    "site/**",
    "demos/*/public/**",
    "packages/emvb-daisyui/generated/**",
    "packages/emvb-daisyui/styles/**"
  ],
  "ignoreDependencies": [
    "@fortawesome/fontawesome-free",
    "@tabler/icons",
    "lucide-static",
    "remixicon",
    "sharp",
    "@perkyzz/emvb-daisyui",
    "@perkyzz/emvb-provider-api"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "core",
        "patterns": ["packages/emvb/src/core/**"]
      },
      {
        "name": "server",
        "patterns": ["packages/emvb/src/server/**"]
      },
      {
        "name": "admin",
        "patterns": ["packages/emvb/src/admin/**"]
      },
      {
        "name": "astro",
        "patterns": ["packages/emvb/src/astro/**"]
      }
    ],
    "rules": [
      {
        "from": "core",
        "allow": []
      },
      {
        "from": "server",
        "allow": ["core"]
      },
      {
        "from": "admin",
        "allow": ["core"]
      },
      {
        "from": "astro",
        "allow": ["core"]
      }
    ]
  },
  "ignoreBinaries": ["setsid"]
}
